{
  "name": "desktop-notes",
  "version": "0.2.0",
  "description": "A macOS desktop sticky notes app",
  "author": "evelyn-zzz <evelyn_zzz@163.com>",
  "license": "MIT",
  "repository": "https://github.com/evelyn-zzz/desktop-notes.git",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist": "pnpm build && electron-builder"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "build": {
    "appId": "com.desktop-notes.app",
    "productName": "Desktop Notes",
    "afterPack": "scripts/afterPack.cjs",
    "mac": {
      "category": "public.app-category.productivity",
      "artifactName": "Desktop-Notes-${version}-${arch}.${ext}",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "resources/**/*"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
